# ── App ──────────────────────────────────────────────────────────────
# Public URL of the app (used for OAuth redirects + invite emails)
NEXT_PUBLIC_SITE_URL=https://os.amzcentric.com
# Comma-separated email domains allowed to sign in, e.g. amzcentric.com
ALLOWED_EMAIL_DOMAINS=amzcentric.com
# Comma-separated emails that are always admins (bootstrap the first admin)
ADMIN_EMAILS=you@amzcentric.com
# Set to "true" to run with generated demo data (no Supabase / Amazon needed).
# Demo mode is also used automatically when NEXT_PUBLIC_SUPABASE_URL is empty.
DEMO_MODE=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Amazon Ads API (Login with Amazon security profile) ─────────────
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
# 32 random bytes, hex or base64. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── Amazon Marketing Stream (SQS) ────────────────────────────────────
# One or more SQS queue URLs, comma-separated (e.g. sp-traffic and sp-conversion queues)
STREAM_SQS_QUEUE_URLS=
# IAM user with sqs:ReceiveMessage + sqs:DeleteMessage on those queues.
# (Vercel reserves AWS_* names, so these are prefixed with STREAM_.)
STREAM_AWS_ACCESS_KEY_ID=
STREAM_AWS_SECRET_ACCESS_KEY=
# Optional — inferred from the queue URL when empty
STREAM_AWS_REGION=

# ── Cron ─────────────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes automatically.
CRON_SECRET=
# How many trailing days the daily cron re-requests (Amazon restates attribution)
REQUEST_LOOKBACK_DAYS=7

# ── Meetings & tasks ─────────────────────────────────────────────────
# Claude API key (platform.claude.com → API keys) for automatic meeting insights + tasks.
# Without it, notes are saved and tasks can still be added by hand or from Claude.
ANTHROPIC_API_KEY=
# Shared secret for recorder / Zapier pushes to /api/meetings/ingest (e.g. `openssl rand -hex 32`)
MEETINGS_INGEST_TOKEN=
